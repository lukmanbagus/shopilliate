{
  "name": "shopilliate",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "Situs kurasi produk Shopee self-hosted di Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukmanbagus/shopilliate.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Opsional. Kode rahasia yang diminta saat membuka halaman /setup pertama kali. Kosongkan jika tidak ingin memakainya."
      }
    }
  },
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "publish": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
