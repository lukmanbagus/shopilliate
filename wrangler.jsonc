{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shopilliate",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-01",
	// React (Vite) build output is served by the same Worker as static assets.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// Without database_id, Cloudflare provisions the resource automatically on deploy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shopilliate-db"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "shopilliate-images"
		}
	],
	"observability": {
		"enabled": true
	}
}